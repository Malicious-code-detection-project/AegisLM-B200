# Copy to .env locally if you want shell helpers to source it.
# Do not commit .env or real token values.

# Two-GPU B200 profile.
CUDA_VISIBLE_DEVICES=0,1
EXPECTED_CUDA_DEVICES=2
EXPECTED_CGROUP_MEMORY_GIB=400

# W&B online logging. Keep the real API key only in the local .env.
WANDB_PROJECT=malware-analysis-llm
WANDB_LOG_MODEL=false
WANDB_WATCH=false
WANDB_API_KEY=

# Hugging Face access. Set only when gated models or datasets require it.
HF_TOKEN=
HF_HOME=/NHNHOME/WORKSPACE/26moel002_ex07/LLM/Cache/huggingface
HF_HUB_CACHE=/NHNHOME/WORKSPACE/26moel002_ex07/LLM/Cache/huggingface/hub

# Local project paths.
LLAMAFACTORY_DIR=vendor/LlamaFactory
DATASET_OUTPUT_DIR=data/processed/hf-full-v1
ZIP_EXTRACT_DIR=data/extracted/security_archives
MODEL_ROOT=model
BASE_MODEL_DIR=model/base
DATA_ROOT=data
RAW_DATA_ROOT=data/raw_data
PHASE_F_SOURCE_OUTPUT_DIR=data/processed/phase-f-source-v2
PHASE_F_BINARY_OUTPUT_DIR=data/processed/phase-f-binary-derived-v1
LOCAL_ARTIFACT_ROOT=training_artifacts
PERSISTENT_ROOT=/NHNHOME/WORKSPACE/26moel002_ex07/LLM
PERSISTENT_ARTIFACT_ROOT=/NHNHOME/WORKSPACE/26moel002_ex07/LLM/TrainingArtifacts
CHECKPOINT_MIRROR_INTERVAL_SECONDS=30
WANDB_DIR=/NHNHOME/WORKSPACE/26moel002_ex07/LLM/TrainingArtifacts/wandb
